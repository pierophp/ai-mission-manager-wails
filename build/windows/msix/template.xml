<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ai_mission_manager"
        Arguments=""
        InstallLocation="C:\Program Files\AI Mission Manager\AI Mission Manager">
    </Installer>
    <PackageInformation
        PackageName="AI Mission Manager"
        PackageDisplayName="AI Mission Manager"
        PublisherName="CN=AI Mission Manager"
        PublisherDisplayName="AI Mission Manager"
        Version="0.1.0.0"
        PackageDescription="Desktop mission manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.piero.aimissionmanager"
                Description="Desktop mission manager"
                DisplayName="AI Mission Manager"
                ExecutableName="ai_mission_manager"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AI Mission Manager</DisplayName>
            <PublisherDisplayName>AI Mission Manager</PublisherDisplayName>
            <Description>Desktop mission manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ai_mission_manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
